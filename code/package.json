    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "manifest": {
    "host_permissions": [
      "*://*.vncare.vn/*",
